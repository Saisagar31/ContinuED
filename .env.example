# Copy to .env.local (never commit real values). Empty = feature off.

# --- Web app (Vite exposes only VITE_* to the browser; never put secrets here) ---
VITE_API_URL=
VITE_COGNITO_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Base URL of published audio packs: <base>/<lang>/manifest.json (task 10). Empty = audio packs off.
VITE_AUDIO_BASE_URL=

# --- Local API dev server ---
API_PORT=8787

# --- Audio build job (task 10) — server/CI side only, never shipped to the browser ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
