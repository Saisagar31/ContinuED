{
  "name": "continued",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ContinuED: offline learning passport for migrant children (teacher PWA + school API).",
  "scripts": {
    "dev": "vite",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "api:dev": "tsx api/dev-server.ts",
    "api:bundle": "esbuild api/src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=api/dist/lambda.js && node -e \"require('fs').writeFileSync('api/dist/package.json', JSON.stringify({type:'commonjs'}))\"",
    "ci": "npm run typecheck && npm test && npm run build",
    "content:review-sheets": "tsx scripts/content/review-sheets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1178.0",
    "@aws-sdk/client-kms": "3.1178.0",
    "@aws-sdk/lib-dynamodb": "3.1178.0",
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "aws-jwt-verify": "5.2.1",
    "idb": "8.0.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@types/node": "^22.15.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "6.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
