    "api:dev": "tsx api/dev-server.ts",
    "ci": "npm run typecheck && npm test && npm run build",
    "content:review-sheets": "tsx scripts/content/review-sheets.ts"
  },
  "dependencies": {
    "idb": "8.0.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
