{
  "name": "continued",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ContinuED: offline learning passport for migrant children (teacher PWA + school API).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
